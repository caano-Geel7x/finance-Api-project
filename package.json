{
  "name": "personal-finance-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run start --prefix backend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --include=dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
